[
  {
    "id": "NAMING-001",
    "level": "MUST",
    "chapter": "programming-conventions",
    "section": "naming",
    "tags": ["naming"],
    "since_go": "1.0",
    "summary": "包名使用小写单词连写。",
    "details": "包名全小写、无下划线与驼峰，标识符同理。",
    "rationale": "包名出现在每个外部引用点，命名不一致会持续抬高阅读成本。",
    "quote": {
      "text": "Package names should be short, concise, and evocative.",
      "source": "https://go.dev/blog/package-names"
    },
    "examples": {
      "good": "package orderbook",
      "bad": "package order_book"
    },
    "sources": ["https://go.dev/wiki/CodeReviewComments#package-names"],
    "detect": {
      "tool": "golangci-lint",
      "rule": "stylecheck(ST1003)",
      "note": "检查包名标识符"
    }
  },
  {
    "id": "COMMENT-001",
    "level": "SHOULD",
    "chapter": "programming-conventions",
    "section": "comments",
    "tags": ["comments"],
    "since_go": "1.0",
    "summary": "注释只写代码表达不出的东西。",
    "details": "注释说明意图与约束，不复述代码在做什么。",
    "rationale": "复述代码的注释会随代码改动失真，标识符改名后尤其明显。",
    "examples": {
      "good": "// retry 只重试幂等请求。",
      "bad": "// i 加一\ni++"
    },
    "sources": ["https://go.dev/wiki/CodeReviewComments#commenting"]
  }
]
